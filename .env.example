# MongoDB connection string
MONGODB_URI=your_mongodb_uristring_here

# Session Secret code
SESSION_SECRET=create_a_secure_random_string_here

# Youtube Api Key and Region Code
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_REGION_CODE=region_code

# Required to invoke POST /api/seed in production. Use a long random secret and
# send it only in the Authorization: Bearer header; never expose it to the browser.
MOVIE_SEED_TOKEN=generate_a_long_random_admin_token_here
